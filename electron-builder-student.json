{
  "appId": "com.pivot.studentclient",
  "productName": "PIVOT Student Client",
  "directories": {
    "output": "dist-electron/student"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "asar": true,
  "asarUnpack": [
    "electron/watchdog.exe"
  ],
  "win": {
    "target": [
      "nsis",
      "portable"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "PIVOT Student Client",
    "perMachine": true,
    "include": "electron/installer.nsh"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "nfsailab",
      "repo": "Pivot-Students-Management",
      "channel": "student"
    }
  ]
}
