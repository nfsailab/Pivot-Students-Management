{
  "appId": "com.pivot.hoddashboard",
  "productName": "PIVOT HOD Dashboard",
  "directories": {
    "output": "dist-electron/hod"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      "nsis",
      "portable"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "PIVOT HOD Dashboard",
    "perMachine": true,
    "include": "electron/installer.nsh"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "nfsailab",
      "repo": "Pivot-Students-Management",
      "channel": "hod"
    }
  ]
}
